# MinerU 文档解析（必需）
# 获取：https://mineru.net → API 管理 → 创建 Token
MINERU_API_TOKEN=

# 大模型调用（必需，OpenAI 兼容协议）
# 获取：https://bailian.console.aliyun.com → API-KEY
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# 团队协作模式（可选）：设为 1 后访问需要登录
# TENDER_TEAM=1